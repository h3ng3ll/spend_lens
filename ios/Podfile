# EXPLICIT — never left commented out, because CocoaPods then silently
# assumes iOS 13.0 and the pod install fails on a dependency floor.
#
# 15.5 is the HIGHEST floor among this app's plugins, not the first one the
# error message happens to name:
#   google_mlkit_* (text_recognition/commons/document_scanner)  15.5  <-- binding
#   firebase_auth / firebase_core / firebase_crashlytics        15.0
#   apphud                                                      15.0
#   google_sign_in_ios 13.0 · permission_handler_apple 12.0 · sign_in_with_apple 12.0
#
# Setting only the 15.0 that CocoaPods reported first would clear THIS error
# and fail again on the next pod install — the same partial-rollout shape that
# bit the Android minSdk fix (apphud's floor of 26) earlier in this build.
platform :ios, '15.5'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

# `permission_handler_apple` compiles each permission strategy behind an
# `#if PERMISSION_*` macro, and `PermissionHandlerEnums.h` defaults every one
# of them to 0 when undefined. At 0 the body of
# `AudioVideoPermissionStrategy.checkPermissionStatus:` is stripped and control
# falls through to a hard `return PermissionStatusDenied;` — so the camera
# permission is denied at COMPILE time. The native AVFoundation call is never
# reached, iOS never shows the system prompt, and iOS never creates the
# Settings -> SpendLens camera row (its absence is the diagnostic tell).
#
# On the CocoaPods build path THIS hook is the only thing that defines the
# macro. (Under SPM it would instead come from the plugin's own Package.swift,
# auto-derived from Info.plist, and this block would be dead code — verified
# not the case here: swift_package_manager_enabled is false for ios and
# Runner.xcodeproj carries zero XCLocalSwiftPackageReference entries.)
#
# `=` with '$(inherited)' first, never `||=`: CocoaPods pre-populates
# GCC_PREPROCESSOR_DEFINITIONS with COCOAPODS=1, so the `||=` form is a silent
# no-op and the macro never applies.
#
# Only PERMISSION_CAMERA is enabled — this app requests no other permission
# group, and every unset macro correctly stays 0 so those strategies compile
# out. Verify in ios/Pods/Pods.xcodeproj/project.pbxproj (post_install writes
# build settings there, NOT into the per-target .xcconfig — grepping only the
# xcconfig gives a false negative).
post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = [
        '$(inherited)',
        'PERMISSION_CAMERA=1',
      ]
    end
  end
end
