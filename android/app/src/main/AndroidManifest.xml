<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- design_spendlens.md §6: camera is used for receipt scanning only.
         `required="false"` lets a camera-less tablet still install the app
         for cash-only use — capability is reported per-device by
         `IScanCapabilityService`, never assumed from the manifest alone. -->
    <uses-permission android:name="com.android.vending.BILLING"/>

    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>

    <!-- Android 13+ predictive back. Without this the platform logs
         "OnBackInvokedCallback is not enabled for the application" and
         routes the back GESTURE straight to the OS instead of to Flutter,
         so a swipe-back on a pushed route EXITED THE APP rather than
         popping — while the in-app Cancel button popped correctly. -->
    <application
        android:label="spend_lens"
        android:name="${applicationName}"
        android:icon="@mipmap/launcher_icon"
        android:enableOnBackInvokedCallback="true">
        <!-- Bundles the ML Kit Latin text-recognition model into the APK at
             install time instead of downloading it on first use — a
             downloaded model would fail on a first launch in airplane mode,
             which design_spendlens.md §64 forbids. M8 wires the real OCR
             call; this metadata must exist from M7 so the model is already
             on-device when M8 lands. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="ocr" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>


</manifest>
