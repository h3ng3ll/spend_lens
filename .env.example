# SpendLens — environment template
#
# Copy to `.env` and fill in real values:   cp .env.example .env
# `.env` is gitignored and is bundled as an asset for ios/android only.
# Every value below is a PLACEHOLDER. Never commit real credentials.
#
# There are no dev/prod flavors in this project: one environment, one file,
# read through the single `Env` class in lib/core/utils/env/env.dart.

# ─────────────────────────── Google Sign-In ───────────────────────────
# OAuth 2.0 *Web* client id from Google Cloud Console → Credentials.
# Passed to GoogleSignIn.initialize(serverClientId:).
# NOTE: this is the client id — NOT a push certificate / VAPID key.
GOOGLE_SERVER_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# iOS OAuth client id, and its reversed form for the URL scheme.
# These also belong in ios/Runner/Info.plist as GIDClientID and
# CFBundleURLSchemes respectively.
GOOGLE_IOS_CLIENT_ID=000000000000-yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy.apps.googleusercontent.com
GOOGLE_IOS_REVERSED_CLIENT_ID=com.googleusercontent.apps.000000000000-yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy

# ──────────────────────────── Apphud ────────────────────────────
# Apphud → Settings → General → API key. Drives all subscription
# entitlement state; the app never validates receipts itself.
APPHUD_APP_STORE_API_KEY=appstr_000000000043000000000
APPHUD_GOOGLE_PLAY_API_KEY=play_000000000043000000000

# ─────────────────────────── Free tier ───────────────────────────
# Optional overrides for lib/core/utils/app_limits.dart defaults.
# Leave blank to use the compiled-in values.
FREE_RECEIPT_LIMIT=50

# ─────────────────────────────────────────────────────────────────────
# NOT stored here — these are platform config files, not env values:
#
#   ios/Runner/GoogleService-Info.plist     (Firebase, iOS)
#   android/app/google-services.json        (Firebase, Android)
#   lib/firebase_options.dart               (flutterfire configure)
#   ios/Runner/Runner.entitlements          (Sign in with Apple capability)
#
# All four are gitignored. Firebase here is used ONLY for Crashlytics and
# optional auth — there is no Firestore sync and receipt images are never
# uploaded.